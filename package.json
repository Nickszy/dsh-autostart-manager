{
  "name": "dsh-autostart-manager",
  "version": "0.3.0",
  "description": "DSH 开机自启：Windows、macOS、Linux 登录后启动桌面客户端或本机 Web 服务。",
  "keywords": ["dsh-plugin", "deepseek-harness", "autostart", "startup", "silent", "windows", "macos", "linux", "web"],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check core.mjs && node --check platforms/entries.mjs && node --check platforms/windows.mjs && node --check assets/web-runner.mjs",
    "test": "node tests/host.test.mjs && node tests/web-runner.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "core.mjs",
    "platforms/",
    "assets/",
    "tests/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs/images/"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
